  {{ service_name }}:
    image: llm-dock-tabbyapi
    container_name: {{ service_name }}
    restart: no

    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]

    ports:
      - "{{ port }}:8000"

    ipc: host

    # Upstream's own compose asks for 8g shm; exllamav3's dataloader/torch
    # multiprocessing paths hit the 64m docker default otherwise.
    shm_size: 8g

    ulimits:
      memlock: -1
      nofile: 1048576

    environment:
      - HF_HUB_OFFLINE=1
{% for k, v in (extra_env or {}).items() %}
      - {{ k }}={{ v }}
{% endfor %}
    volumes:
      # Two supply paths, both valid as TabbyAPI's model_dir root:
      #   /hf-cache — HF-cached EXL3 repos. The WHOLE hub must be mounted, not a
      #     snapshot subdir: HF snapshots are directories of relative symlinks
      #     into ../../blobs, so a narrower bind mount breaks every weight file.
      #     model_path then looks like a ds4 one: .../models--org--name/snapshots/<rev>.
      #   /exl3 — flat directory of real model folders, for models converted with
      #     exllamav3's convert.py (or copied, not symlinked, out of the cache).
      - ${HOME}/.cache/huggingface:/hf-cache:ro
      - ${HOME}/.cache/exl3:/exl3:ro
      # Per-service auth keys, generated by tabby_keys.ensure() during template
      # rendering. Absolute host path so an LLM_DOCK_TABBY_KEYS_DIR override is
      # honored. Bind-mounted read-only: TabbyAPI only writes this file when it
      # is absent, and a missing bind source makes Docker create a directory,
      # which TabbyAPI then fails to parse.
      - {{ key_file }}:/app/api_tokens.yml:ro

    networks:
      - llm-network

    # Entrypoint is `python3 main.py` (set in the image), so everything below is
    # TabbyAPI args. Two divergences from the other runners, both deliberate:
    # args are config.yml OVERRIDES with dashes (--max-seq-len), and every arg
    # takes a value INCLUDING BOOLEANS — a bare `--vision` is an argparse error,
    # so bool params must be stored as "True"/"False", never "".
    command: >
      --host 0.0.0.0
      --port 8000
      --model-dir {{ model_dir }}
      --model-name {{ model_name }}
      {% for flag in rendered_flags %}{{ flag }}
      {% endfor %}
