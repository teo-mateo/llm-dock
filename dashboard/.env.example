DASHBOARD_TOKEN=your-secret-token-here
# Set to 1 when the dashboard sits behind a TLS-terminating reverse proxy that
# sends X-Forwarded-Proto, so the session cookie gets the Secure flag.
# DASHBOARD_TRUST_PROXY_HEADERS=0
DASHBOARD_PORT=3399
DASHBOARD_HOST=0.0.0.0
COMPOSE_PROJECT_NAME=llm-dock
COMPOSE_FILE=../docker-compose.yml
LOG_LEVEL=INFO
LLM_DOCK_API_KEY=your-global-api-key-here
# Optional: enables OpenRouter-hosted models in the chat model pickers.
# OPENROUTER_API_KEY=sk-or-v1-...
