+void emit_prometheus_family(std::string& out, const std::string& name, const char* type,
+                            const char* help, const std::string& value) {
+    out += "# HELP ";
+    out += name;
+    out += ' ';
+    out += help;
+    out += "\n# TYPE ";
+    out += name;
+    out += ' ';
+    out += type;
+    out += "\n";
+    out += name;
+    out += ' ';
+    out += value;
+    out += '\n';
+}
+
+// Unlabeled families: the server hosts one model, and the dashboard scrapes one
+// family set per service. Counters are process-lifetime; a container restart
+// resets them, which the dashboard's Math.max(0, delta) clamp already handles.
+//
+// `kv_capacity_page_groups` is passed in rather than read from MemorySummary here:
+// MemorySummary takes execution_mutex_, which the worker holds across every execution
+// unit, so reading it at scrape time serializes /metrics behind generation.
+std::string render_metrics_snapshot(const ninfer::RuntimeStats& stats,
+                                    std::uint32_t kv_capacity_page_groups) {
+    // Occupied pages over the page-group capacity; clamped to [0, 1] and 0 when
+    // the capacity is unknown. The raw pair is emitted alongside (kv_occupied_pages
+    // / kv_capacity_page_groups), so a wrong unit ratio is visible and fixable.
+    double kv_usage = 0.0;
+    if (kv_capacity_page_groups > 0) {
+        kv_usage = static_cast<double>(stats.device_main_kv_occupied_pages) /
+                   static_cast<double>(kv_capacity_page_groups);
+        if (kv_usage < 0.0) { kv_usage = 0.0; }
+        if (kv_usage > 1.0) { kv_usage = 1.0; }
+    }
+    std::string out;
+    emit_prometheus_family(
+        out, "ninfer:prompt_tokens_total", "counter",
+        "Prompt tokens evaluated by prefill; reused checkpoint-prefix tokens excluded.",
+        std::to_string(stats.computed_prefill_tokens));
+    emit_prometheus_family(out, "ninfer:generation_tokens_total", "counter",
+                           "Tokens committed by decode rounds.",
+                           std::to_string(stats.committed_decode_tokens));
+    emit_prometheus_family(out, "ninfer:decode_rounds_total", "counter",
+                           "Decode batch executions.", std::to_string(stats.decode_rounds));
+    emit_prometheus_family(out, "ninfer:num_requests_running", "gauge",
+                           "Requests actively decoding.",
+                           std::to_string(stats.running_requests));
+    emit_prometheus_family(out, "ninfer:num_requests_waiting", "gauge",
+                           "Requests waiting for capacity.",
+                           std::to_string(stats.waiting_requests));
+    emit_prometheus_family(out, "ninfer:num_requests_prefilling", "gauge",
+                           "Requests in prefill.", std::to_string(stats.prefilling_requests));
+    emit_prometheus_family(out, "ninfer:kv_cache_usage_perc", "gauge",
+                           "Device main KV occupancy over capacity, clamped to [0, 1].",
+                           std::to_string(kv_usage));
+    emit_prometheus_family(out, "ninfer:kv_occupied_pages", "gauge",
+                           "Device main KV occupied pages (raw).",
+                           std::to_string(stats.device_main_kv_occupied_pages));
+    emit_prometheus_family(out, "ninfer:kv_capacity_page_groups", "gauge",
+                           "Device main KV capacity in page groups (raw).",
+                           std::to_string(kv_capacity_page_groups));
+    emit_prometheus_family(
+        out, "ninfer:prefix_cache_queries_total", "counter",
+        "Prompt tokens presented, computed plus reused (monotonic by construction).",
+        std::to_string(stats.computed_prefill_tokens + stats.reused_prompt_tokens));
+    emit_prometheus_family(out, "ninfer:prefix_cache_hits_total", "counter",
+                           "Prompt tokens served from reused prefixes.",
+                           std::to_string(stats.reused_prompt_tokens));
+    emit_prometheus_family(out, "ninfer:host_kv_occupied_bytes", "gauge",
+                           "Host KV residency in bytes (raw).",
+                           std::to_string(stats.host_kv_occupied_bytes));
+    return out;
+}
