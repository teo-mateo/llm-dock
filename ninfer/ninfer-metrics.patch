+void HttpServer::handle_metrics(const httplib::Request&, httplib::Response& res) const {
+    // /health mirror: 503 until the service is attached and ready. Auth is the
+    // pre-routing handler's job (it guards every path but /health and OPTIONS),
+    // so no key check here.
+    if (service_ == nullptr || !service_->is_available()) {
+        res.status = 503;
+        res.set_content(nlohmann::json{{"status", "unavailable"}}.dump(), "application/json");
+        return;
+    }
+    res.set_content(render_metrics_snapshot(service_->runtime_stats(), kv_capacity_page_groups_),
+                    "text/plain; version=0.0.4; charset=utf-8");
+}
